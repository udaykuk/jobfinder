# Copy this file to .env and fill in your values. .env is git-ignored.
GOOGLE_API_KEY=
# Optional: JOBFINDER_MODEL=gemini-3.5-flash-lite

# Login for the app. If APP_PASSWORD is empty, a random one is printed in the logs at startup.
APP_USERNAME=uday
APP_PASSWORD=

# Optional social login. Each provider appears only when its ID and secret are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ALLOWED_GITHUB_USERS=your-github-username
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_GOOGLE_EMAILS=you@gmail.com

# Only needed for PostgreSQL (e.g. Neon when deploying). Leave out to use the local H2 file database.
# DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# DATABASE_USER=
# DATABASE_PASSWORD=
